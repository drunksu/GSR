# ============================================================================
#  .gitignore —— 只同步"代码 + 配置 + 文档"，不同步大体积产物
# ============================================================================

# ---- 虚拟环境（244 MB，每台机器自己重建）----
/mobile/

# ---- 评测产物：只排除体积巨大的截图与元素树，**小文件要同步** ----
# 单轮 310 个任务的 PNG 就 2.7 GB、XML 另有 200 MB；而
# trajectory.json / episodes.jsonl / result_list.txt / report.md / api_metrics.jsonl
# 加起来才几 MB —— 这些是另一台机器唯一能看到结果的途径，必须入库。
# （曾经用 **/results/** 整目录排除，导致"上传了报告"其实什么都没上来）
step_*.png
step_*.xml
*_som.png
step_*.jpg

# ---- 合成实验数据（可用 make_sim_data.py 重新生成，9 MB）----
/experiments/results/sim/

# ---- platform-tools：只提交 adb 运行必需的 3 个文件（8.1 MB）----
# 这样新机器 clone 完就有 adb，不用下载（Windows 自带 curl 常因
# CRYPT_E_REVOCATION_OFFLINE 失败）。其余 exe（fastboot/sqlite3/...）不提交。
/third_party/platform-tools/*
!/third_party/platform-tools/adb.exe
!/third_party/platform-tools/AdbWinApi.dll
!/third_party/platform-tools/AdbWinUsbApi.dll
/third_party/platform-tools.zip
/third_party/android_home/
/third_party/mbl.tar.gz
/third_party/mbl_paper.html
/third_party/mbl_paper.txt
/third_party/models_all.json
/third_party/*.zip
/third_party/*.tar.gz

# ---- MobileBench-OL 上游自带的演示图片（约 20 MB，跑实验用不到）----
/third_party/mobilebench-ol-main/MobileAgent_new/Mobile-Agent-v2/results/
/third_party/mobilebench-ol-main/MobileAgent_new/Mobile-Agent-v2/screenshot/
/third_party/mobilebench-ol-main/MobileAgent_new/Mobile-Agent-v2/assets/
/third_party/mobilebench-ol-main/tmp_smoke/
/third_party/mobilebench-ol-main/*.bak

# ---- 参考论文 PDF（7.6 MB；想同步就 git add -f paper/）----
/paper/

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/

# ---- 零散产物 ----
/experiments/scripts/coord_probe.png
*.log
